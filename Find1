    };
    for (const C& c : data) n.addConnection(c.a, c.b, c.t, "Bus", c.r);
}

// ---------- console helpers ----------
static string ask(const string& prompt) {
    cout << prompt;
    string s;
    getline(cin, s);
    return trim(s);
}

static void routeQuery(const TransportNetwork& net, bool fastestMode) {
    string a = ask("Source station     : "), b = ask("Destination station: ");
    const string *src = net.find(a), *dst = net.find(b);
    if (!src || !dst) { cout << "Please enter valid station names.\n"; return; }
    if (*src == *dst) { cout << "Source and destination are the same station.\n"; return; }
    vector<Edge> path;
    bool ok = fastestMode ? net.fastest(*src, *dst, path) : net.fewestStops(*src, *dst, path);
    if (!ok) { cout << "No route found from " << *src << " to " << *dst << ".\n"; return; }
    TransportNetwork::printPath(path);
}

// ---------- API mode: one tab-separated command per line in, one JSON line out ----------
static vector<string> splitTabs(const string& s) {
    vector<string> parts;
    size_t start = 0, p;
    while ((p = s.find('\t', start)) != string::npos) { parts.push_back(s.substr(start, p - start)); start = p + 1; }
    parts.push_back(s.substr(start));
    return parts;
}

static string result(bool ok, const string& message) {
    return string("{\"ok\":") + (ok ? "true" : "false") + ",\"message\":" + TransportNetwork::js(message) + "}";
}

static void apiLoop(TransportNetwork& net) {
    string line;
    while (getline(cin, line)) {
        if (!line.empty() && line.back() == '\r') line.pop_back();
        vector<string> f = splitTabs(line);
        f.resize(max<size_t>(f.size(), 6));
        const string& cmd = f[0];
        string out;
        if (cmd == "STATS") out = net.statsJson();
        else if (cmd == "STATIONS") out = net.stationsJson();
        else if (cmd == "NETWORK") out = net.networkJson();
        else if (cmd == "ROUTES") out = net.routesJson();
        else if (cmd == "SEARCH") out = net.searchJson(f[1]);
        else if (cmd == "FAST") out = net.routeJson(true, f[1], f[2]);
        else if (cmd == "MIN") out = net.routeJson(false, f[1], f[2]);
        else if (cmd == "ADDSTATION") {
            string n = trim(f[1]);
            out = n.empty() ? result(false, "Please enter a station name.")
                : net.addStation(n) ? result(true, "Station \u201c" + n + "\u201d added.")
                                    : result(false, "That station already exists.");
        } else if (cmd == "ADDCONN") {
            int t = 0;
            try { t = stoi(f[3]); } catch (...) { t = 0; }
            string err = net.addConnection(f[1], f[2], t, trim(f[4]), trim(f[5]));
            out = err.empty() ? result(true, "Connection added.") : result(false, err);
        } else out = result(false, "Unknown command.");
        cout << out << "\n" << flush;
    }
}

int main(int argc, char** argv) {
    TransportNetwork net;
    loadDefaultNetwork(net);

    if (argc > 1 && string(argv[1]) == "--api") {
        apiLoop(net);
        return 0;
    }

    cout << "==========================================\n"
         << "     PUBLIC TRANSPORT ROUTE FINDER\n"
         << "==========================================\n";

    for (;;) {
        cout << "\n1. Dashboard (statistics, stations, network)\n"
             << "2. Fastest route (Dijkstra)\n"
             << "3. Minimum stops route (BFS)\n"
             << "4. Search station\n"
             << "5. All routes\n"
             << "6. Add station\n"
             << "7. Add connection\n"
             << "0. Exit\n";
        string choice = ask("Choose an option: ");

        if (choice == "1") { net.printStats(); net.printStations(); net.printNetwork(); }
        else if (choice == "2") routeQuery(net, true);
        else if (choice == "3") routeQuery(net, false);
        else if (choice == "4") net.search(ask("Station name (or part of it): "));
        else if (choice == "5") net.printRoutes();
        else if (choice == "6") {
            string n = ask("New station name: ");
            cout << (net.addStation(n) ? "Station added.\n" : "Invalid name or station already exists.\n");
        } else if (choice == "7") {
            string a = ask("Source station     : "), b = ask("Destination station: ");
            int t = 0;
            try { t = stoi(ask("Travel time (min)   : ")); } catch (...) { t = 0; }
            string type = ask("Transport type (Bus/Metro/Tram): ");
            string route = ask("Route number (e.g. B1, M2, T3): ");
            string err = net.addConnection(a, b, t, type, route);
            cout << (err.empty() ? "Connection added.\n" : err + "\n");
        } else if (choice == "0") { cout << "Goodbye!\n"; break; }
        else cout << "Invalid option.\n";

        if (!cin) break;   // input closed
    }
    return 0;
}
